schema_version = 1

[publish.targets.rustfs]
provider = "s3"
endpoint = "http://127.0.0.1:9000"
bucket = "nexora-updater-example"
region = "us-east-1"
force_path_style = true
public_base_url = "http://127.0.0.1:9000/nexora-updater-example"
allow_insecure_http = true

[apps.updater-windows]
package = "nexora-updater-windows-example"
app_id = "com.nexora.examples.updater-windows"
display_name = "Windows 更新程序示例"
publish_target = "rustfs"
object_prefix = "e2e"

[apps.updater-windows.branding]
application_logo = "assets/logos/updater-windows/logo-icon-128.png"
icon_source = "assets/logos/updater-windows/logo-icon-source.png"
managed = true

[apps.updater-windows.release]
default_channel = "stable"
version = "1.0.1"
build_number = 5
minimum_supported_version = "0.0.0"
signing_key_file = ".secrets/updater-windows.key"

[apps.updater-windows.release.channels.beta]

[apps.updater-windows.release.channels.stable]

[apps.updater-windows.updater]
enabled = true
check_on_launch = true
channels = ["stable", "beta"]
trusted_public_keys = ["updater-windows-main:ed25519:REPLACE_WITH_PUBLIC_KEY"]
signing_key_env = "NEXORA_EXAMPLE_UPDATE_SIGNING_KEY"
check_interval = "15m"
check_jitter = "1m"
offline_grace_period = "24h"
mandatory_restart_delay = "60s"
health_timeout = "20s"

[apps.updater-windows.platforms.macos]
icon = "assets/logos/updater-windows/logo-icon.icns"
signing = "ad_hoc"
notarize = false

[apps.updater-windows.platforms.windows]
icon = "assets/logos/updater-windows/logo-icon.ico"
publisher = "Nexora Examples"
signing = "authenticode"
signing_thumbprint = "0123456789ABCDEF0123456789ABCDEF01234567"
expected_publisher = "Nexora Examples"
timestamp_url = "http://timestamp.digicert.com"
desktop_shortcut_default = false
start_menu_shortcut_default = true
launch_after_install_default = true
minimum_windows_build = 15063

[apps.updater-windows.platforms.linux]
icons = [
    "assets/logos/updater-windows/logo-icon-16.png",
    "assets/logos/updater-windows/logo-icon-24.png",
    "assets/logos/updater-windows/logo-icon-32.png",
    "assets/logos/updater-windows/logo-icon-48.png",
    "assets/logos/updater-windows/logo-icon-64.png",
    "assets/logos/updater-windows/logo-icon-128.png",
    "assets/logos/updater-windows/logo-icon-256.png",
    "assets/logos/updater-windows/logo-icon-512.png",
    "assets/logos/updater-windows/logo-icon-1024.png",
]
