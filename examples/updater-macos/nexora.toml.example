schema_version = 1

[publish.targets.rustfs]
provider = "s3"
endpoint = "http://127.0.0.1:9000"
bucket = "nexora-updater-example"
region = "us-east-1"
force_path_style = true
public_base_url = "http://127.0.0.1:9000/nexora-updater-example"
allow_insecure_http = true

[apps.updater-macos]
package = "nexora-updater-macos-example"
app_id = "com.nexora.examples.updater-macos"
display_name = "macOS 更新程序示例"
publish_target = "rustfs"
object_prefix = "e2e"

[apps.updater-macos.branding]
application_logo = "assets/logos/updater-macos/logo-icon-128.png"
icon_source = "assets/logos/updater-macos/logo-icon-source.png"
managed = true

[apps.updater-macos.release]
channel = "stable"
version = "${CARGO_PKG_VERSION}"
build_number = "${BUILD_DATETIME}"
minimum_supported_version = "0.0.0"
signing_key_file = ".secrets/updater-macos.key"

[apps.updater-macos.updater]
enabled = true
check_on_launch = true
feed_url = "http://127.0.0.1:9000/nexora-updater-example/e2e/updater-macos/stable/latest.json"
channels = ["stable"]
trusted_public_keys = ["updater-macos-main:ed25519:REPLACE_WITH_PUBLIC_KEY"]
signing_key_env = "NEXORA_EXAMPLE_UPDATE_SIGNING_KEY"
check_interval = "15m"
check_jitter = "1m"
offline_grace_period = "24h"
mandatory_restart_delay = "60s"
health_timeout = "20s"

[apps.updater-macos.targets]
required = ["aarch64-apple-darwin"]

[apps.updater-macos.platforms.macos]
icon = "assets/logos/updater-macos/logo-icon.icns"
signing = "ad_hoc"
notarize = false

[apps.updater-macos.platforms.windows]
icon = "assets/logos/updater-macos/logo-icon.ico"

[apps.updater-macos.platforms.linux]
icons = [
    "assets/logos/updater-macos/logo-icon-16.png",
    "assets/logos/updater-macos/logo-icon-24.png",
    "assets/logos/updater-macos/logo-icon-32.png",
    "assets/logos/updater-macos/logo-icon-48.png",
    "assets/logos/updater-macos/logo-icon-64.png",
    "assets/logos/updater-macos/logo-icon-128.png",
    "assets/logos/updater-macos/logo-icon-256.png",
    "assets/logos/updater-macos/logo-icon-512.png",
    "assets/logos/updater-macos/logo-icon-1024.png",
]
